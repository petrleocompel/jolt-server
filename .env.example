# Copy to .env and fill in. Never commit .env.
# For a self-hosted deployment see docs/SELFHOSTING.md.

NODE_ENV=development

# The public domain this server is reached on. Used for BETTER_AUTH_URL, the
# Caddy site block, and the Traefik router rule.
APP_HOST=jolt.example.com
# Optional: override the full public origin. Defaults to https://$APP_HOST.
# Set this if you terminate TLS elsewhere or run plain HTTP on a LAN.
# PUBLIC_URL=http://192.168.1.10:7385

# Postgres — matches deploy/docker-compose.yml.
# The port is published only with deploy/docker-compose.dev.yml; set
# POSTGRES_HOST_PORT if 5432 is taken on your machine.
DATABASE_URL=postgres://jolt:jolt@127.0.0.1:5432/jolt
# Used by the db container. Change both for anything internet-facing.
POSTGRES_USER=jolt
POSTGRES_PASSWORD=jolt
POSTGRES_DB=jolt

# Better Auth — generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Extra origins browsers may sign in from, comma-separated. Sign-in is refused
# from any origin not listed here or in BETTER_AUTH_URL, and the login form can
# only report that as a failed login. Set this if the server answers to more
# than one name (a LAN IP, a `www.` alias). The loopback names of a dev server
# are trusted automatically.
# TRUSTED_ORIGINS=http://192.168.1.10:7385

# APNs (token-based auth, App Store Connect .p8 key).
# Leave blank to run without push: the server falls back to ConsolePushSender
# and logs what it would have sent instead of contacting Apple. Everything
# except delivery of pokes to a backgrounded app still works.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=cz.peelco.jolt
# The full .p8 contents. Keep the literal \n escapes if setting via CI variable.
APNS_KEY_P8=
APNS_ENV=sandbox

# IANA zone the time in notification text is rendered in ("zapped you — 30%
# at 14:32 UTC"). Alert bodies are built server-side, so there is no
# recipient locale to use; the zone name is printed alongside the time.
PUSH_TIME_ZONE=UTC

SENTRY_DSN=

# May a friend's automations (their personal access tokens) poke someone who
# hasn't said yes to it? Leave unset and an admin decides at /admin/settings
# (default: allowed unless the recipient blocks them). Set true to require
# each recipient's consent per friend and stimulus, or false to pin the
# default — either way the admin page shows it as locked. Accepts
# true/false, 1/0, yes/no, on/off; anything else stops the server starting.
# AUTOMATION_CONSENT_REQUIRED=false

POKE_EVENT_RETENTION_DAYS=90
FRIEND_REQUEST_EXPIRY_DAYS=30

# Consumed only by `pnpm db:seed-admin`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin
ADMIN_HANDLE=admin

# Set by CI for the test deploy; ignored locally.
# JOLT_IMAGE=ghcr.io/petrleocompel/jolt-server:latest
