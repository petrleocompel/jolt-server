{
  "packageManager": "pnpm@10.33.0",
  "name": "jolt-server",
  "description": "Self-hostable backend for the Jolt iOS app: friends, per-stimulus permissions and pokes delivered to Pavlok wearables over APNs.",
  "license": "AGPL-3.0-only",
  "homepage": "https://petrleocompel.github.io/jolt-server/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petrleocompel/jolt-server.git"
  },
  "bugs": {
    "url": "https://github.com/petrleocompel/jolt-server/issues"
  },
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:up": "docker compose -p jolt-server-e2e -f deploy/docker-compose.e2e.yml up -d --wait",
    "e2e:down": "docker compose -p jolt-server-e2e -f deploy/docker-compose.e2e.yml down -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed-admin": "tsx scripts/seed-admin.ts",
    "openapi:generate": "tsx scripts/openapi-generate.ts",
    "openapi:check": "tsx scripts/openapi-generate.ts --check",
    "cron": "tsx scripts/cron.ts"
  },
  "dependencies": {
    "@sentry/tanstackstart-react": "^11.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "~1.7.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "nitro": "3.0.260903-beta",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.46",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "@sentry/cli",
      "unrs-resolver"
    ]
  }
}
